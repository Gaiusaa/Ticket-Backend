<%-include("partials/head")%>
<%-include("partials/nav")%>
<div class = "content-div flex-column">
    <div class = "page-div shadow flex-column">
        <h1 class = "title"><%=ticket.id%></h1>
            <table class = "round outline">
                <tbody>
                    <tr>
                        <th>Epost</th>
                        <td><%=ticket.email%></td>
                    </tr>
                    <tr>
                        <th>Signatur</th>
                        <td><%=ticket.signature || "n/a"%></td>
                    </tr>
                    <tr>
                        <th>Problem</th>
                        <td><template><%=ticket.description%></template></td>
                    </tr>
                    <tr>
                        <th>Område</th>
                        <td><%=ticket.Location%></td>
                    </tr>
                    <tr>
                        <th>Prioritet</th>
                        <td><%=ticket.priority%></td>
                    </tr>
                    <tr>
                        <th>On-site</th>
                        <td><%=ticket.onSite%></td>
                    </tr>
                </tbody>
            </table>
        <div class = "page-actions">
            <button class = "button round" id = "delete">FJERN</button>
        </div>
    </div>
</div>


<%-include("partials/foot")%>